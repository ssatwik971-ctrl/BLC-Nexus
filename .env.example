# Local development only. Netlify injects NETLIFY_DB_URL when Netlify Database is enabled.
# For local Netlify development, use `netlify dev` and its local database support.
NETLIFY_DB_URL=
# JWT_SECRET is only used by the legacy standalone backend; Netlify Identity handles hosted sessions.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
FRONTEND_URL=http://localhost:8888
CORS_ORIGINS=http://localhost:8888

# SMTP for the "you're approved, create your account" email and application decision emails.
# Netlify Identity itself sends the account confirmation and password-recovery emails.
# Without SMTP_HOST these emails are only written to the function log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=BLC Nexus <no-reply@example.com>
CONTACT_EMAIL=
DISCORD_WEBHOOK_URL=
# Netlify Functions cap request/response bodies at ~6 MB, so keep uploads at 4 MB or less.
MAX_UPLOAD_MB=4

# Admin account: set these in Netlify (Project configuration -> Environment variables), scoped to Functions.
# Open /admin-login and unlock the admin with this email + PIN. PIN: at least 6 characters, 8+ recommended.
ADMIN_EMAIL=
ADMIN_PIN=
# Optional: display name and session length in hours
ADMIN_NAME=BLC Admin
ADMIN_SESSION_HOURS=12
