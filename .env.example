# ---- BLC Nexus API configuration (copy to backend/.env) ----
NODE_ENV=development
SITE_NAME=BLC Nexus
PORT=4000

# PostgreSQL connection string (docker-compose.yml provides this one locally)
DATABASE_URL="postgresql://blc:blc_dev_password@localhost:5432/blc_nexus?schema=public"

# REQUIRED in production: a long random string, e.g. `openssl rand -hex 48`
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Where the web app is served from (used in emails and for CORS)
FRONTEND_URL=http://localhost:5173
# Extra allowed origins, comma separated (optional)
CORS_ORIGINS=http://localhost:5173

# File uploads (document vault). Use a persistent volume in production.
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# Email (SendGrid/Mailgun/any SMTP). If SMTP_HOST is empty, emails are printed to the server log.
# SendGrid example: SMTP_HOST=smtp.sendgrid.net  SMTP_PORT=587  SMTP_USER=apikey  SMTP_PASS=<api key>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="BLC Nexus <no-reply@blcnexus.com>"
# Where the public Contact form messages are delivered
CONTACT_EMAIL=

# Optional Discord webhook for event/vote announcements
DISCORD_WEBHOOK_URL=

# First admin created by `npm run db:seed` (you are forced to change the password on first login)
SEED_ADMIN_EMAIL=admin@blcnexus.local
SEED_ADMIN_PASSWORD=ChangeMe!2026
SEED_ADMIN_NAME=BLC Leader
