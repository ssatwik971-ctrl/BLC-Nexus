{
  "name": "blc-nexus-api",
  "version": "1.0.0",
  "private": true,
  "description": "BLC Nexus API — The Command Center of the Billionaires Club (unofficial Ticarium companion) (dependencies are installed from the repository root package.json)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "start:prod": "node src/server.js",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "db:generate-sql": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script --output ../netlify/database/migrations/202611010001_initial_schema.sql"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
