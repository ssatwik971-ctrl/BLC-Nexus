// BLC Nexus — database schema (PostgreSQL via Prisma)
// Unofficial fan companion for Ticarium: Business Tycoon. All "money"/"coin"
// values are in-game resources tracked manually. No real-money features.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"] // rhel target = Netlify Functions runtime
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MEMBER
  OFFICER
  ADMIN
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  WAITLISTED
}

enum PaymentStatus {
  UNPAID
  PAID
  LATE
  WAIVED
}

enum VoteStatus {
  DRAFT
  OPEN
  CLOSED
}

enum DonationType {
  CASH
  COINS
}

enum BoardKind {
  ACTIVITY
  DONATION
}

model User {
  id                 String     @id @default(uuid())
  email              String     @unique
  netlifyIdentityId  String?    @unique
  passwordHash       String?
  inGameName         String     @unique
  playerId           String?
  role               Role       @default(MEMBER)
  status             UserStatus @default(INVITED)
  avatarUrl          String?
  timezone           String     @default("UTC")
  contact            String?
  hiddenFields       String[]   @default([])
  notifyEmail        Boolean    @default(true)
  mustChangePassword Boolean    @default(false)
  inviteTokenHash    String?    @unique
  inviteExpires      DateTime?
  resetTokenHash     String?    @unique
  resetExpires       DateTime?
  joinedAt           DateTime   @default(now())
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  assignments   MaintenanceAssignment[]
  donations     Donation[]
  donationStatuses WeeklyDonationStatus[]
  threads       ForumThread[]
  posts         ForumPost[]
  upvotes       PostUpvote[]
  voteRecords   VoteRecord[]
  notifications Notification[]
  application   Application?
}

model Application {
  id            String            @id @default(uuid())
  email         String
  inGameName    String
  playerId      String
  level         Int?
  power         String?
  weeklyActivity String?
  stats         Json?
  reason        String
  references    String?
  status        ApplicationStatus @default(PENDING)
  tokenHash     String            @unique
  decisionNote  String?
  reviewedAt    DateTime?
  userId        String?           @unique
  user          User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt     DateTime          @default(now())

  @@index([status])
}

model Office {
  id              String   @id @default(uuid())
  name            String   @unique
  description     String?
  level           Int      @default(1)
  weeklyMoneyCost Float    @default(0)
  weeklyCoinCost  Int      @default(0)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())

  assignments MaintenanceAssignment[]
}

model MaintenanceAssignment {
  id        String        @id @default(uuid())
  officeId  String
  userId    String
  weekStart DateTime      @db.Date
  dueAt     DateTime?
  status    PaymentStatus @default(UNPAID)
  paidAt    DateTime?
  note      String?
  createdAt DateTime      @default(now())

  office Office @relation(fields: [officeId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([officeId, userId, weekStart])
  @@index([weekStart])
}

// Cash and coin donations to the cooperative. Recorded by officers after the
// member donates in-game (there is no pledge step in the game).
model Donation {
  id           String       @id @default(uuid())
  userId       String
  type         DonationType
  amount       Float
  note         String?
  donatedAt    DateTime     @default(now())
  recordedById String?
  createdAt    DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([type, userId])
  @@index([donatedAt])
}

// Total maintenance the cooperative paid for one week (cash + coins). Entered by the
// admin only at the end of the week; it is deducted from the coop's total balance.
model MaintenanceExpense {
  id          String   @id @default(uuid())
  weekStart   DateTime @unique @db.Date
  cash        Float    @default(0)
  coins       Int      @default(0)
  note        String?
  enteredById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Whether a member gave the minimum weekly donation. Officers and the admin set it;
// every member can see it.
model WeeklyDonationStatus {
  id          String   @id @default(uuid())
  userId      String
  weekStart   DateTime @db.Date
  met         Boolean  @default(false)
  updatedById String?
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
  @@index([weekStart])
}

// Server-side sessions for the single admin (signed in with ADMIN_EMAIL + ADMIN_PIN).
// Only a SHA-256 hash of the random session token is stored.
model AdminSession {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  pinCheck  String // sha256(token + PIN): changing ADMIN_PIN signs every old session out
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model ForumCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  threads ForumThread[]
}

model ForumThread {
  id         String   @id @default(uuid())
  categoryId String
  userId     String
  title      String
  pinned     Boolean  @default(false)
  locked     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category ForumCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts    ForumPost[]

  @@index([categoryId])
}

model ForumPost {
  id        String   @id @default(uuid())
  threadId  String
  userId    String
  content   String
  createdAt DateTime @default(now())

  thread  ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  upvotes PostUpvote[]

  @@index([threadId])
}

model PostUpvote {
  postId String
  userId String

  post ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
}

model WikiPage {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  content     String
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Vote {
  id           String     @id @default(uuid())
  title        String
  description  String?
  options      Json
  eligibleRole Role       @default(MEMBER)
  startTime    DateTime   @default(now())
  endTime      DateTime
  status       VoteStatus @default(OPEN)
  createdById  String?
  createdAt    DateTime   @default(now())

  records VoteRecord[]
}

model VoteRecord {
  id             String   @id @default(uuid())
  voteId         String
  userId         String
  optionSelected String
  votedAt        DateTime @default(now())

  vote Vote @relation(fields: [voteId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([voteId, userId])
}

model Document {
  id            String   @id @default(uuid())
  title         String
  description   String?
  fileName      String
  storedName    String   @unique
  mimeType      String
  size          Int
  category      String   @default("General")
  visibleToRole Role     @default(MEMBER)
  uploadedById  String?
  createdAt     DateTime @default(now())
}

model AuditSnapshot {
  id          String   @id @default(uuid())
  date        DateTime @db.Date
  power       Float
  rank        Int?
  memberCount Int?
  notes       String?
  createdAt   DateTime @default(now())

  @@index([date])
}

// Admin action log (who changed what in BLC Nexus)
model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  detail    Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model LeaderboardEntry {
  id        String    @id @default(uuid())
  kind      BoardKind
  name      String
  score     Float
  rank      Int
  updatedAt DateTime  @updatedAt

  @@index([kind, rank])
}

model SiteSetting {
  key   String @id
  value Json
}
