{
  "name": "blc-nexus",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate --schema backend/prisma/schema.prisma",
    "build": "npm --prefix frontend run build",
    "prebuild": "npm run prisma:generate",
    "dev": "npx netlify-cli dev",
    "db:init": "npx netlify-cli database init",
    "db:status": "npx netlify-cli database status",
    "db:connect": "npx netlify-cli database connect",
    "db:migrations:apply": "npx netlify-cli database migrations apply",
    "prisma:generate": "prisma generate --schema backend/prisma/schema.prisma",
    "db:generate-sql": "npm --prefix backend run db:generate-sql",
    "test": "npm --prefix backend test"
  },
  "dependencies": {
    "@netlify/aws-lambda-compat": "^2.0.3",
    "@netlify/blobs": "11.1.4",
    "@netlify/database": "^2.0.1",
    "@netlify/identity": "^2.0.0",
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.14",
    "prisma": "^6.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.26.0",
    "recharts": "^2.12.7",
    "serverless-http": "^3.2.0",
    "winston": "^3.14.2",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=20.12.2"
  },
  "overrides": {
    "@netlify/otel": "7.0.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
