{
  "name": "blc-nexus",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "build": "npm run build --workspace frontend",
    "prebuild": "npm run prisma:generate --workspace backend",
    "dev": "npx netlify-cli dev",
    "db:init": "npx netlify-cli database init",
    "db:status": "npx netlify-cli database status",
    "db:connect": "npx netlify-cli database connect",
    "db:migrations:apply": "npx netlify-cli database migrations apply",
    "prisma:generate": "npm run prisma:generate --workspace backend",
    "db:generate-sql": "npm run db:generate-sql --workspace backend",
    "test": "npm test --workspace backend"
  },
  "dependencies": {
    "@netlify/database": "^2.0.1",
    "@netlify/blobs": "^11.1.7",
    "serverless-http": "^3.2.0",
    "@netlify/identity": "^2.0.0",
    "@netlify/aws-lambda-compat": "^2.0.3"
  },
  "engines": {
    "node": ">=20.12.2"
  }
}
